{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "gendb": "bunx prisma migrate dev",
    "generate": "bunx prisma generate",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "sanity": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.10.4",
    "@prisma/client": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0"
  }
}